# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: URL pública do app (usada no link de recuperação de senha). Ex.: https://app.seudominio.com.br
APP_URL=

# SESSION_SECRET: segredo HMAC-SHA256 dos tokens de sessão. OBRIGATÓRIO, mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor encerra todas as sessões (uso emergencial).
SESSION_SECRET=

# SUPABASE_URL: URL do projeto Supabase.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: chave de serviço (sb_secret_... / service_role). OBRIGATÓRIA.
# Exclusiva do backend. NUNCA usar prefixo VITE_ e nunca expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_ANON_KEY: chave pública (publishable). Não é usada pelo backend.
SUPABASE_ANON_KEY=

# TRUST_PROXY: defina "1" apenas se o app roda atrás de um proxy reverso confiável (para o rate limit usar o IP real).
TRUST_PROXY=

# FORCE_HTTPS: "true" para redirecionar HTTP -> HTTPS em produção (atrás de proxy com X-Forwarded-Proto).
FORCE_HTTPS=

# Envio de e-mail de recuperação de senha (opcional). Sem isso, use o reset assistido pelo admin.
RESEND_API_KEY=
EMAIL_FROM=
